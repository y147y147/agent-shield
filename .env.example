# 复制为 .env 后填写（.env 已在 .gitignore，不会进仓库）
# 不要把真实 Key 粘贴到聊天 / Issue / PR。

OPENAI_API_KEY=sk-your-key-here
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# 通义示例：
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 沙箱后端：auto（有 Docker 用容器，否则 local）| local | docker
# AGENT_SHIELD_SANDBOX=auto
# AGENT_SHIELD_SANDBOX_IMAGE=alpine:3.20
